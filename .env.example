# ElevenLabs: used only by `npm run sfx` on your machine. Never shipped to the browser.
# Get a key at https://elevenlabs.io/app/settings/api-keys (needs "Sound Effects" + "Text to Speech" access).
ELEVENLABS_API_KEY=

# Optional: the announcer's voice (any voice id from your ElevenLabs Voice Library).
# Leave empty for the default.
ELEVENLABS_VOICE_ID=
